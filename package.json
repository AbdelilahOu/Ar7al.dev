{
  "name": "portfolio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions --fix-dangerously",
    "dev": "alchemy dev alchemy.dev.ts",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "deploy": "alchemy deploy alchemy.prod.ts",
    "destroy": "alchemy destroy alchemy.prod.ts",
    "deploy:preview": "alchemy deploy alchemy.preview.ts",
    "destroy:preview": "alchemy destroy alchemy.preview.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^25.9.9",
    "alchemy": "^0.85.2",
    "oxlint": "^1.94.0",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.5",
  "catalog": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@orpc/client": "^1.16.4",
    "@orpc/openapi": "^1.16.4",
    "@orpc/server": "^1.16.4",
    "@orpc/zod": "^1.16.4",
    "@types/node": "^25.9.9",
    "alchemy": "^0.85.2",
    "dotenv": "^17.4.2",
    "hono": "^4.13.19",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
}
